---
import { getImage, Image } from "astro:assets";
import { render } from "astro:content";
import avatar from "@/assets/avatar.jpg";
import PostList from "@/components/PostList.astro";
import { profile } from "@/data/profile";
import Base from "@/layouts/Base.astro";
import { formatDay, isoDay } from "@/lib/dates";
import { OG_HEIGHT, OG_WIDTH } from "@/lib/og-image";
import { getPosts, readingMinutes, type Post } from "@/lib/posts";

export async function getStaticPaths() {
  // Declared here because Astro runs getStaticPaths in isolation from the rest of the frontmatter.
  const KEEP_READING_COUNT = 2;
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, others: posts.filter((other) => other.id !== post.id).slice(0, KEEP_READING_COUNT) },
  }));
}

interface Props {
  post: Post;
  others: Post[];
}

const { post, others } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, cover, coverAlt } = post.data;
if (cover && (cover.width < OG_WIDTH || cover.height < OG_HEIGHT)) {
  throw new Error(
    `The cover of "${post.id}" is ${cover.width}×${cover.height}. It must be at least ${OG_WIDTH}×${OG_HEIGHT} pixels, so the link preview isn't blurry.`,
  );
}
// A cover is cropped to the preview size; otherwise a card is generated by ./[slug]/og.png.ts.
const previewImage = cover
  ? (await getImage({ src: cover, width: OG_WIDTH, height: OG_HEIGHT, fit: "cover", format: "jpg" })).src
  : `/writing/${post.id}/og.png`;
---

<Base title={title} description={description} section="writing" image={previewImage} publishedTime={pubDate}>
  <article class="article">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a> › <a href="/writing/">Writing</a> › <span aria-current="page">{title}</span>
    </nav>
    <h1>{title}</h1>
    <p class="subtitle">{description}</p>
    <div class="byline">
      <Image src={avatar} alt="" width={80} height={80} />
      <div>
        {profile.name}
        <span>
          <time datetime={isoDay(pubDate)}>{formatDay(pubDate)}</time> · {readingMinutes(post)} min read
          {updatedDate && <> · updated <time datetime={isoDay(updatedDate)}>{formatDay(updatedDate)}</time></>}
        </span>
      </div>
    </div>
    {cover && <Image class="cover" src={cover} alt={coverAlt ?? ""} widths={[680, 1360]} sizes="(max-width: 720px) 100vw, 680px" />}
    <div class="prose"><Content /></div>
    {others.length > 0 && (
      <aside class="keep">
        <h2>Keep reading</h2>
        <PostList posts={others} />
      </aside>
    )}
  </article>
</Base>
